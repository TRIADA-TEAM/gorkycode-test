APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/assistant.db
DEFAULT_TIMEZONE=Europe/Moscow
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Lightning
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://api.giga.chat/v1
GIGACHAT_VERIFY_SSL=true
POLZA_API_KEY=
POLZA_API_URL=https://polza.ai/api/v1
POLZA_STT_MODEL=openai/whisper-large-v3-turbo
POLZA_STT_LANGUAGE=ru
POLZA_STT_TIMEOUT=60
POLZA_STT_MAX_RETRIES=3
MAX_AUDIO_BYTES=10485760
DIALOGUE_TTL_MINUTES=30
